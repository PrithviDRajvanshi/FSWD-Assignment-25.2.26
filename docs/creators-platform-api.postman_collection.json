{
  "info": {
    "_postman_id": "d1f5c34d-7a7d-4a6a-8ee8-creator-platform-api",
    "name": "Creator's Platform API",
    "description": "Manual and lightweight automated API checks for the Creator's Platform backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Health response includes success and message', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.be.a('string');",
                  "    pm.expect(json.timestamp).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/api/connection-test",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "connection-test"
              ]
            },
            "description": "Checks that the API is reachable from the local development environment."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Registered user response has core fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('_id');",
                  "    pm.expect(json).to.have.property('name');",
                  "    pm.expect(json).to.have.property('email');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.environment.set('authToken', json.token);",
                  "}",
                  "",
                  "const body = JSON.parse(pm.request.body.raw);",
                  "pm.environment.set('userEmail', body.email);",
                  "pm.environment.set('userPassword', body.password);",
                  "pm.environment.set('userName', body.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/users/register",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "register"
              ]
            },
            "description": "Registers a user for local API testing. The tests also save the submitted user details to environment variables for reuse."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login response includes token and user object', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json.user).to.have.property('_id');",
                  "    pm.expect(json.user).to.have.property('email');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('authToken', json.token);",
                  "pm.environment.set('userId', json.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/users/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "users",
                "login"
              ]
            },
            "description": "Logs in the registered user and stores the JWT in {{authToken}} for authenticated requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Posts response includes success, data, and pagination', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.pagination).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/posts?page=1&limit=10",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lists posts. This route is public in the codebase, but the assignment requires authenticated requests to include the bearer token."
          },
          "response": []
        },
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Create post response includes success and created post data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.eql('Post created successfully');",
                  "    pm.expect(json.data).to.have.property('_id');",
                  "    pm.expect(json.data).to.have.property('title');",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('postId', json.data._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman API Test Post\",\n  \"description\": \"Created from the exported Postman collection.\",\n  \"content\": \"This request verifies authenticated post creation in the Creator's Platform API.\",\n  \"tags\": [\"postman\", \"api\", \"testing\"],\n  \"coverImage\": \"https://example.com/cover-image.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/posts",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "posts"
              ]
            },
            "description": "Creates a new post and saves its ID into {{postId}} for update and delete requests."
          },
          "response": []
        },
        {
          "name": "Update Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Update response includes success and updated title', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.title).to.eql('Updated Postman API Test Post');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman API Test Post\",\n  \"description\": \"Updated from Postman.\",\n  \"content\": \"This updated body validates the protected update flow.\",\n  \"tags\": [\"postman\", \"update\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/api/posts/{{postId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "Updates the post created in the previous step using the saved {{postId}}."
          },
          "response": []
        },
        {
          "name": "Delete Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Delete response confirms successful removal', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.message).to.eql('Post deleted successfully');",
                  "});",
                  "",
                  "pm.environment.unset('postId');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/posts/{{postId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "posts",
                "{{postId}}"
              ]
            },
            "description": "Deletes the post created by this collection. Run Create Post first so {{postId}} is populated."
          },
          "response": []
        }
      ]
    }
  ],
